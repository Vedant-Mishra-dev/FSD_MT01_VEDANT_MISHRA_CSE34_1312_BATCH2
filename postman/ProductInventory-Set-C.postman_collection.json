    {
      "name": "11 - DELETE existing product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/303",
        "description": "Expected: HTTP 200 and the deleted USB Keyboard record."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Deleted product is USB Keyboard\", () => { const data = pm.response.json(); pm.expect(data.message).to.eql(\"Product deleted successfully.\"); pm.expect(data.product.id).to.eql(303); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12 - DELETE missing product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/99999",
        "description": "Expected: HTTP 404 because the product does not exist."
      },
      "event": [
        {
