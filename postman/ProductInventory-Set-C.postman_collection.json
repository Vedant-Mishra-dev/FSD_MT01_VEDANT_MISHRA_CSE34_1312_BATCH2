          }
        }
      ],
      "response": []
    },
    {
      "name": "13 - GET filter (case-insensitive match)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/filter?category=eLeCtRoNiCs",
        "description": "Expected: HTTP 200 and products in the Electronics category. Matching is case-insensitive."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns only Electronics products\", () => { const data = pm.response.json(); pm.expect(data).to.be.an(\"array\").that.is.not.empty; data.forEach(product => pm.expect(product.category.toLowerCase()).to.eql(\"electronics\")); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "14 - GET filter (no matches)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/filter?category=Furniture",
        "description": "Expected: HTTP 200 and an empty JSON array."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"No-match response is an empty array\", () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "15 - GET filter (missing category)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/filter",
        "description": "Expected: HTTP 400 because the category query parameter is missing."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400 Bad Request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": []
    }
